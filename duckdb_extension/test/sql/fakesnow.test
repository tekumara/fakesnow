# name: test/sql/fakesnow.test
# description: test fakesnow extension
# group: [fakesnow]

require fakesnow

query I
SELECT _fs_sum(x) FROM (SELECT 1 AS x)
----
1

query R
SELECT _fs_sum(x) FROM (SELECT '1' AS x)
----
1.0

query T
SELECT typeof(_fs_sum(x)) FROM (SELECT 1 AS x)
----
BIGINT

query T
SELECT typeof(_fs_sum(x)) FROM (SELECT '1' AS x)
----
DOUBLE
